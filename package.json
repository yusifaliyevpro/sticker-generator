    "lint": "oxlint",
    "check": "greenly"
  },
  "dependencies": {
    "canvas": "3.2.3",
    "emoji-db": "16.0.1",
    "express": "5.3.0",
    "lru-cache": "11.5.3",
    "morgan": "1.12.1",
    "sharp": "0.35.5",
    "smartcrop-sharp": "2.0.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "24.19.2",
    "greenly": "1.2.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.x"
    }
